{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"background": {
			"backgroundImage": true,
			"backgroundSize": true
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"customDuotone": false,
			"palette": [
				{ "slug": "cream", "color": "#FBF4EC", "name": "Cream" },
				{ "slug": "cream-deep", "color": "#F3E7DC", "name": "Cream (deep)" },
				{ "slug": "paper", "color": "#FFFDFB", "name": "Paper" },
				{ "slug": "rose", "color": "#C98A8F", "name": "Rose" },
				{ "slug": "rose-tint", "color": "#F1DCDD", "name": "Rose tint" },
				{ "slug": "berry", "color": "#8C2F3F", "name": "Berry" },
				{ "slug": "berry-dark", "color": "#6E2231", "name": "Berry (dark)" },
				{ "slug": "sage", "color": "#7E8C6E", "name": "Sage" },
				{ "slug": "gold", "color": "#BB9457", "name": "Gold" },
				{ "slug": "ink-soft", "color": "#5C4650", "name": "Ink (soft)" },
				{ "slug": "ink", "color": "#34202A", "name": "Ink" }
			],
			"gradients": [
				{
					"slug": "cream-to-tint",
					"name": "Cream to rose tint",
					"gradient": "linear-gradient(160deg, #FBF4EC 0%, #F1DCDD 100%)"
				},
				{
					"slug": "ink-veil",
					"name": "Ink veil",
					"gradient": "linear-gradient(0deg, rgba(52, 20, 28, .82) 0%, rgba(52, 20, 28, .1) 60%, transparent 80%)"
				}
			]
		},
		"dimensions": {
			"aspectRatio": true,
			"minHeight": true
		},
		"layout": {
			"contentSize": "46rem",
			"wideSize": "1180px"
		},
		"position": {
			"sticky": true
		},
		"spacing": {
			"blockGap": true,
			"customSpacingSize": true,
			"defaultSpacingSizes": false,
			"units": [ "px", "em", "rem", "vh", "vw", "%" ],
			"spacingSizes": [
				{ "slug": "20", "name": "1", "size": "0.5rem" },
				{ "slug": "30", "name": "2", "size": "1rem" },
				{ "slug": "40", "name": "3", "size": "1.5rem" },
				{ "slug": "50", "name": "4", "size": "2.5rem" },
				{ "slug": "60", "name": "5", "size": "4rem" },
				{ "slug": "70", "name": "6", "size": "6rem" },
				{ "slug": "80", "name": "7", "size": "clamp(4rem, 9vw, 7.5rem)" }
			]
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"customFontSize": true,
			"lineHeight": true,
			"letterSpacing": true,
			"writingMode": true,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Cormorant Garamond",
					"fontFamily": "\"Cormorant Garamond\", Cormorant, Garamond, Georgia, \"Times New Roman\", serif"
				},
				{
					"slug": "sans",
					"name": "Work Sans",
					"fontFamily": "\"Work Sans\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Oxygen-Sans, Ubuntu, Cantarell, \"Helvetica Neue\", sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "x-small", "name": "X-Small", "size": "0.8125rem", "fluid": false },
				{ "slug": "small", "name": "Small", "size": "0.9375rem", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "1.0625rem", "fluid": { "min": "1rem", "max": "1.0625rem" } },
				{ "slug": "large", "name": "Large", "size": "1.375rem", "fluid": { "min": "1.2rem", "max": "1.375rem" } },
				{ "slug": "x-large", "name": "X-Large", "size": "1.9rem", "fluid": { "min": "1.5rem", "max": "1.9rem" } },
				{ "slug": "xx-large", "name": "XX-Large", "size": "2.85rem", "fluid": { "min": "2rem", "max": "2.85rem" } },
				{ "slug": "huge", "name": "Huge", "size": "4.1rem", "fluid": { "min": "2.6rem", "max": "4.1rem" } }
			]
		},
		"custom": {
			"radius": {
				"soft": "14px",
				"arch": "50% 50% 0 0 / 14% 14% 0 0"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|cream",
			"text": "var:preset|color|ink"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|sans",
			"fontSize": "var:preset|font-size|medium",
			"fontWeight": "400",
			"lineHeight": "1.65"
		},
		"spacing": {
			"blockGap": "1.2rem",
			"padding": {
				"top": "0",
				"bottom": "0",
				"left": "clamp(1.25rem, 5vw, 4rem)",
				"right": "clamp(1.25rem, 5vw, 4rem)"
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontWeight": "600",
					"lineHeight": "1.14"
				},
				"color": { "text": "var:preset|color|ink" }
			},
			"h1": { "typography": { "fontSize": "var:preset|font-size|huge", "lineHeight": "1.08" } },
			"h2": { "typography": { "fontSize": "var:preset|font-size|xx-large" } },
			"h3": { "typography": { "fontSize": "var:preset|font-size|x-large" } },
			"h4": { "typography": { "fontSize": "var:preset|font-size|large" } },
			"h5": { "typography": { "fontSize": "var:preset|font-size|medium" } },
			"h6": {
				"typography": {
					"fontFamily": "var:preset|font-family|sans",
					"fontSize": "var:preset|font-size|x-small",
					"fontWeight": "600",
					"textTransform": "uppercase",
					"letterSpacing": "0.06em"
				},
				"color": { "text": "var:preset|color|berry" }
			},
			"link": {
				"color": { "text": "var:preset|color|berry" },
				"typography": { "textDecoration": "none" },
				":hover": { "color": { "text": "var:preset|color|ink" }, "typography": { "textDecoration": "underline" } },
				":focus": { "color": { "text": "var:preset|color|ink" } }
			},
			"button": {
				"color": { "background": "var:preset|color|berry", "text": "var:preset|color|paper" },
				"typography": {
					"fontFamily": "var:preset|font-family|sans",
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "600",
					"letterSpacing": "0.01em"
				},
				"border": { "radius": "100px" },
				"spacing": { "padding": { "top": "0.95em", "bottom": "0.95em", "left": "1.9em", "right": "1.9em" } },
				":hover": { "color": { "background": "var:preset|color|berry-dark", "text": "var:preset|color|paper" } },
				":focus": { "color": { "background": "var:preset|color|berry-dark", "text": "var:preset|color|paper" } },
				":active": { "color": { "background": "var:preset|color|berry-dark", "text": "var:preset|color|paper" } }
			},
			"caption": {
				"color": { "text": "var:preset|color|ink-soft" },
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontSize": "var:preset|font-size|small",
					"fontStyle": "italic"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontSize": "var:preset|font-size|large",
					"fontWeight": "600"
				},
				"elements": {
					"link": {
						"color": { "text": "var:preset|color|ink" },
						"typography": { "textDecoration": "none" },
						":hover": { "color": { "text": "var:preset|color|berry" }, "typography": { "textDecoration": "none" } }
					}
				}
			},
			"core/site-tagline": {
				"typography": {
					"fontFamily": "var:preset|font-family|sans",
					"fontSize": "var:preset|font-size|small"
				},
				"color": { "text": "var:preset|color|ink-soft" }
			},
			"core/navigation": {
				"typography": {
					"fontFamily": "var:preset|font-family|sans",
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "500"
				}
			},
			"core/post-title": {
				"typography": { "fontSize": "var:preset|font-size|xx-large", "lineHeight": "1.12" }
			},
			"core/post-terms": {
				"typography": {
					"fontFamily": "var:preset|font-family|sans",
					"fontSize": "var:preset|font-size|x-small",
					"fontWeight": "600",
					"letterSpacing": "0.04em"
				}
			},
			"core/post-date": {
				"color": { "text": "var:preset|color|ink-soft" },
				"typography": {
					"fontFamily": "var:preset|font-family|sans",
					"fontSize": "var:preset|font-size|small"
				}
			},
			"core/post-author-name": {
				"typography": {
					"fontFamily": "var:preset|font-family|sans",
					"fontSize": "var:preset|font-size|small"
				}
			},
			"core/query-title": {
				"typography": { "fontSize": "var:preset|font-size|xx-large" }
			},
			"core/quote": {
				"border": { "left": { "color": "var:preset|color|berry", "width": "2px" } },
				"spacing": { "padding": { "left": "var:preset|spacing|40" } },
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontSize": "var:preset|font-size|large",
					"fontStyle": "italic"
				}
			},
			"core/pullquote": {
				"border": {
					"top": { "color": "var:preset|color|gold", "width": "1px" },
					"bottom": { "color": "var:preset|color|gold", "width": "1px" }
				},
				"color": { "text": "var:preset|color|ink" },
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontSize": "var:preset|font-size|x-large",
					"fontStyle": "italic",
					"lineHeight": "1.25"
				}
			},
			"core/separator": {
				"color": { "text": "var:preset|color|gold" }
			},
			"core/code": {
				"color": { "background": "var:preset|color|paper", "text": "var:preset|color|ink" },
				"border": { "color": "var:preset|color|gold", "radius": "var:custom|radius|soft", "width": "1px" },
				"spacing": { "padding": { "top": "var:preset|spacing|40", "bottom": "var:preset|spacing|40", "left": "var:preset|spacing|40", "right": "var:preset|spacing|40" } }
			},
			"core/preformatted": {
				"color": { "background": "var:preset|color|paper", "text": "var:preset|color|ink" }
			},
			"core/table": {
				"typography": { "fontSize": "var:preset|font-size|small" },
				"border": { "color": "var:preset|color|gold", "width": "1px", "style": "solid" }
			},
			"core/footnotes": {
				"typography": { "fontSize": "var:preset|font-size|small" },
				"color": { "text": "var:preset|color|ink-soft" }
			}
		},
		"css": "body{-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale}"
	},
	"customTemplates": [
		{
			"name": "page-no-title",
			"title": "Page (no title, full width)",
			"postTypes": [ "page" ]
		}
	],
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
